generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  surname     String?
  location    String?
  bggUsername String?
  avatarUrl   String?
  displayName String?
  role        String   @default("user")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupMemberships  GroupMember[]
  votes             Vote[]
  gameComments      GameComment[]
  gameReviews       GameReview[]
  addedGames        GroupGame[]
  createdGroups     Group[]                  @relation("GroupCreator")
  createdSessions   GameSession[]            @relation("SessionCreator")
  createdEvents     Event[]                  @relation("EventCreator")
  eventAttendances  EventAttendee[]
  addedEventGames   EventGame[]              @relation("EventGameAdder")
  eventReviews      EventReview[]
  eventPhotos       EventPhoto[]
  groupPhotos       GroupPhoto[]
  activityLogs      ActivityLog[]
  reportsMade       Report[]                 @relation("ReportAuthor")
  blocksMade        Block[]                  @relation("BlocksMade")
  blocksReceived    Block[]                  @relation("BlocksReceived")
  notificationPrefs NotificationPreference[]
  deviceTokens      DeviceToken[]
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Group {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("friends")
  createdAt     DateTime @default(now())
  createdById   String
  createdBy     User     @relation("GroupCreator", fields: [createdById], references: [id])
  inviteCode    String?  @unique
  inviteEnabled Boolean  @default(true)

  members      GroupMember[]
  invitations  GroupInvitation[]
  games        GroupGame[]
  sessions     GameSession[]
  activityLogs ActivityLog[]
  photos       GroupPhoto[]
}

model GroupMember {
  id           String    @id @default(cuid())
  groupId      String
  userId       String
  role         String    @default("member")
  pinned       Boolean   @default(false)
  joinedAt     DateTime  @default(now())
  lastPingedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvitation {
  id        String   @id @default(cuid())
  groupId   String
  email     String
  token     String   @unique @default(cuid())
  status    String   @default("pending")
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Game {
  id            String   @id @default(cuid())
  bggId         Int      @unique
  name          String
  thumbnail     String?
  yearPublished Int?
  minPlayers    Int?
  maxPlayers    Int?
  playingTime   Int?
  bggRating     Float?
  bggRank       Int?
  weight        Float?
  updatedAt     DateTime @updatedAt

  groupGames   GroupGame[]
  sessionGames GameSessionGame[]
  eventGames   EventGame[]
}

model GameSession {
  id           String   @id @default(cuid())
  groupId      String
  name         String?
  date         DateTime
  playerCount  Int
  totalMinutes Int
  status       String   @default("planned") // planned, playing, completed
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User              @relation("SessionCreator", fields: [createdById], references: [id])
  games     GameSessionGame[]
  reviews   GameReview[]

  @@index([groupId])
  @@index([date])
}

model GameSessionGame {
  id        String @id @default(cuid())
  sessionId String
  gameId    String
  order     Int
  status    String @default("pending") // pending, playing, completed, skipped

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  game    Game        @relation(fields: [gameId], references: [id])

  @@unique([sessionId, gameId])
}

model GroupGame {
  id         String    @id @default(cuid())
  groupId    String
  gameId     String
  addedById  String
  addedAt    DateTime  @default(now())
  playedAt   DateTime?
  archivedAt DateTime?

  group    Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  game     Game          @relation(fields: [gameId], references: [id])
  addedBy  User          @relation(fields: [addedById], references: [id])
  votes    Vote[]
  comments GameComment[]
  reviews  GameReview[]

  @@unique([groupId, gameId])
  @@index([groupId])
}

model CollectionGame {
  id            String    @id @default(cuid())
  bggUsername   String
  bggId         Int
  name          String
  thumbnail     String?
  yearPublished Int?
  minPlayers    Int?
  maxPlayers    Int?
  bggRating     Float?
  bggRank       Int?
  weight        Float?
  playingTime   Int?
  numPlays      Int       @default(0)
  userRating    Float?
  bestWith      String?
  subtype       String    @default("boardgame") // boardgame | boardgameexpansion
  dateAdded     DateTime?
  fetchedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([bggUsername, bggId])
  @@index([bggUsername])
  @@index([bggRank])
  @@index([bggRating])
  @@index([numPlays])
  @@index([dateAdded])
  @@index([subtype])
}

model GameComment {
  id          String    @id @default(cuid())
  groupGameId String
  userId      String
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  groupGame GroupGame @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([groupGameId, userId])
  @@index([groupGameId])
  @@index([userId])
}

// Crónica / reseña post-partida: opinión de un usuario sobre un juego del
// grupo DESPUÉS de jugarlo. A diferencia de GameComment (nota de por qué se
// propone, 1 por usuario/juego), aquí puede haber varias por usuario/juego
// (una por partida) y llevan nota y fotos. Alimenta el feed y la galería.
model GameReview {
  id          String   @id @default(cuid())
  groupGameId String
  userId      String
  sessionId   String? // enlace opcional a una partida concreta
  rating      Int? // 1-5, opcional
  text        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupGame GroupGame         @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])
  session   GameSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  photos    GameReviewPhoto[]

  @@index([groupGameId])
  @@index([userId])
  @@index([sessionId])
}

model GameReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  url       String   @db.Text // URL pública en Supabase Storage
  order     Int      @default(0)
  createdAt DateTime @default(now())

  review GameReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// Foto suelta de la galería de un grupo, no atada a ninguna opinión. La sube
// cualquier miembro.
model GroupPhoto {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  url       String   @db.Text // URL pública en Supabase Storage
  caption   String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@index([userId])
}

model Vote {
  id          String   @id @default(cuid())
  groupGameId String
  userId      String
  value       Int      @default(1)
  createdAt   DateTime @default(now())

  groupGame GroupGame @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([groupGameId, userId])
  @@index([groupGameId])
  @@index([userId])
}

model Event {
  id           String    @id @default(cuid())
  name         String
  description  String?
  date         DateTime
  endDate      DateTime?
  location     String?
  maxAttendees Int?
  imageUrl     String?   @db.Text
  visibility   String    @default("public") // public | private
  inviteCode   String?   @unique
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy    User            @relation("EventCreator", fields: [createdById], references: [id])
  games        EventGame[]
  reviews      EventReview[]
  photos       EventPhoto[]
  attendees    EventAttendee[]
  activityLogs ActivityLog[]

  @@index([date])
  @@index([visibility])
}

model EventGame {
  id        String   @id @default(cuid())
  eventId   String
  gameId    String
  addedById String
  addedAt   DateTime @default(now())

  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  game      Game                @relation(fields: [gameId], references: [id])
  addedBy   User                @relation("EventGameAdder", fields: [addedById], references: [id])
  interests EventGameInterest[]

  @@unique([eventId, gameId])
  @@index([eventId])
}

model EventAttendee {
  id       String   @id @default(cuid())
  eventId  String
  userId   String
  status   String   @default("attending") // attending | maybe | cancelled
  joinedAt DateTime @default(now())

  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])
  interests EventGameInterest[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventGameInterest {
  id          String   @id @default(cuid())
  eventGameId String
  attendeeId  String
  intensity   Int // 1-5
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventGame EventGame     @relation(fields: [eventGameId], references: [id], onDelete: Cascade)
  attendee  EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([eventGameId, attendeeId])
  @@index([eventGameId])
  @@index([attendeeId])
}

// Valoración de un evento por un asistente (nota + comentario). Una por
// usuario y evento. Se pide por email cuando el evento acaba.
model EventReview {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  rating    Int? // 1-5, opcional
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Foto de la galería de un evento. Cualquier participante (creador o
// asistente) puede subir; no va atada a una valoración.
model EventPhoto {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  url       String   @db.Text // URL pública en Supabase Storage
  caption   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  scope     String   @default("internal")
  userId    String
  groupId   String?
  eventId   String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
  @@index([eventId, createdAt])
}

// Caché durable de imágenes de juegos de BGG (por bggId), para no volver a
// pedir a BGG las fotos de resultados de búsqueda ya vistos. Solo positivos.
model BggThumbnail {
  bggId     Int      @id
  thumbnail String?
  fetchedAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────
// Moderación de contenido de usuario
//
// La directriz 1.2 de Apple exige que una app con contenido generado por
// usuarios permita denunciar contenido y bloquear personas. Sin estas dos
// piezas funcionando de verdad, App Store rechaza la app.
// ─────────────────────────────────────────────────────────────────────────

model Report {
  id         String    @id @default(cuid())
  reporterId String
  // Tipo e id del objeto denunciado. Se guarda así, y no con una clave ajena
  // por tipo, porque se puede denunciar contenido de tablas muy distintas
  // (fotos, opiniones, comentarios) y el objeto puede desaparecer después.
  targetType String // photo | review | comment | user
  targetId   String
  reason     String // offensive | sexual | harassment | spam | other
  detail     String?
  status     String    @default("pending") // pending | actioned | dismissed
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewNote String?

  reporter User @relation("ReportAuthor", fields: [reporterId], references: [id])

  // Una persona solo puede denunciar una vez el mismo objeto.
  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id])
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ─────────────────────────────────────────────────────────────────────────
// Notificaciones
//
// Cada tipo de aviso se puede recibir por email, por push o por ninguno de
// los dos. Solo se guardan filas para lo que el usuario cambia respecto al
// valor por defecto de su tipo (ver src/lib/notifications.ts).
// ─────────────────────────────────────────────────────────────────────────

model NotificationPreference {
  id     String  @id @default(cuid())
  userId String
  type   String // ping | session_created | event_reminder | new_vote | new_photo | ...
  email  Boolean @default(true)
  push   Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
}

// Token del dispositivo para las push (APNs vía FCM en iOS, FCM en Android).
model DeviceToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String // ios | android | web
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
