generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  surname    String?
  location   String?
  bggUsername String?
  // Enlace para que otro usuario consulte tu colección en modo lectura.
  // null = no compartida. Regenerarlo invalida el enlace anterior.
  collectionShareToken String? @unique
  avatarUrl    String?
  displayName  String?
  // Slug de la URL del perfil público (/users/<slug>). Se reclama solo a
  // partir del usuario de BGG cuando está libre; si no, el perfil vive en su
  // id. Va en su propio campo para que sobreviva a un cambio de usuario de
  // BGG y para poder dejar editarlo a mano más adelante.
  slug         String?  @unique
  role         String   @default("user")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  groupMemberships GroupMember[]
  votes            Vote[]
  gameComments     GameComment[]
  gameReviews      GameReview[]
  addedGames       GroupGame[]
  createdGroups    Group[]        @relation("GroupCreator")
  createdSessions  GameSession[]  @relation("SessionCreator")
  createdEvents    Event[]        @relation("EventCreator")
  eventAttendances EventAttendee[]
  addedEventGames  EventGame[]    @relation("EventGameAdder")
  addedManuals     Game[]         @relation("GameManualAdder")
  eventReviews     EventReview[]
  eventPhotos      EventPhoto[]
  groupPhotos      GroupPhoto[]
  activityLogs     ActivityLog[]
  emailChangeRequests EmailChangeRequest[]
  feedbacks         Feedback[]    @relation("FeedbackAuthor")
  reviewedFeedbacks Feedback[]    @relation("FeedbackReviewer")
  createdFeatures   Feature[]     @relation("FeatureCreator")
  featureVotes      FeatureVote[]
  collectionEntries CollectionEntry[]
  gameFlags         UserGameFlag[]
  friendships       Friendship[]  @relation("FriendshipOwner")
  friendOf          Friendship[]  @relation("FriendshipFriend")
  notifications     Notification[] @relation("NotificationRecipient")
  sentNotifications Notification[] @relation("NotificationActor")
  communityThreads  CommunityThread[]
  communityReplies  CommunityReply[]
  communityLikes    CommunityReplyLike[]
  pushSubscriptions PushSubscription[]
  reportsMade       Report[]      @relation("ReportReporter")
  reportsReceived   Report[]      @relation("ReportTargetUser")
  reportsResolved   Report[]      @relation("ReportResolver")
  blocksMade        UserBlock[]   @relation("BlockBlocker")
  blockedBy         UserBlock[]   @relation("BlockBlocked")
}

// Código de acceso por email. Solo vale el último que se ha pedido, y
// `attempts` cuenta cuántas veces se ha probado contra él (ver verify-code).
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, code])
  @@index([email, createdAt])
}

// Solicitud de cambio de email de un usuario ya logueado. El código se manda
// al email NUEVO (prueba de que es suyo) y solo se guarda su hash. Se
// invalidan las solicitudes previas al crear una nueva, y `attempts` corta
// los intentos a ciegas sobre el código.
model EmailChangeRequest {
  id        String    @id @default(cuid())
  userId    String
  newEmail  String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Group {
  id            String   @id @default(cuid())
  name          String
  type          String   @default("friends")
  createdAt     DateTime @default(now())
  createdById   String
  createdBy     User     @relation("GroupCreator", fields: [createdById], references: [id])
  inviteCode    String?  @unique
  inviteEnabled Boolean  @default(true)

  members     GroupMember[]
  invitations GroupInvitation[]
  games       GroupGame[]
  sessions      GameSession[]
  activityLogs  ActivityLog[]
  photos        GroupPhoto[]
  notifications Notification[]
}

model GroupMember {
  id           String    @id @default(cuid())
  groupId      String
  userId       String
  role         String    @default("member")
  pinned       Boolean   @default(false)
  joinedAt     DateTime  @default(now())
  lastPingedAt DateTime?

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvitation {
  id        String   @id @default(cuid())
  groupId   String
  email     String
  token     String   @unique @default(cuid())
  status    String   @default("pending")
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([email])
}

model Game {
  id            String   @id @default(cuid())
  bggId         Int      @unique
  name          String
  thumbnail     String?
  yearPublished Int?
  minPlayers    Int?
  maxPlayers    Int?
  playingTime   Int?
  bggRating     Float?
  bggRank       Int?
  weight        Float?
  updatedAt     DateTime @updatedAt

  // Página del manual en BGG (boardgamegeek.com/filepage/…), que aporta
  // cualquiera: la API de BGG no da los ficheros de un juego. Se puede
  // denunciar (tipo "game_manual").
  manualUrl       String?
  manualAddedById String?
  manualAddedAt   DateTime?
  manualAddedBy   User?     @relation("GameManualAdder", fields: [manualAddedById], references: [id], onDelete: SetNull)

  groupGames   GroupGame[]
  sessionGames GameSessionGame[]
  eventGames   EventGame[]

  // Las carátulas del feed se buscan por nombre (withGameCovers)
  @@index([name])
}

model GameSession {
  id           String   @id @default(cuid())
  groupId      String
  name         String?
  date         DateTime
  playerCount  Int
  totalMinutes Int
  status       String   @default("planned") // planned, playing, completed
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  group     Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy User              @relation("SessionCreator", fields: [createdById], references: [id])
  games     GameSessionGame[]
  reviews   GameReview[]

  @@index([groupId])
  @@index([date])
}

model GameSessionGame {
  id        String @id @default(cuid())
  sessionId String
  gameId    String
  order     Int
  status    String @default("pending") // pending, playing, completed, skipped

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  game    Game        @relation(fields: [gameId], references: [id])

  @@unique([sessionId, gameId])
}

model GroupGame {
  id        String    @id @default(cuid())
  groupId   String
  gameId    String
  addedById String
  addedAt   DateTime  @default(now())
  playedAt   DateTime?
  archivedAt DateTime?

  group    Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  game     Game          @relation(fields: [gameId], references: [id])
  addedBy  User          @relation(fields: [addedById], references: [id])
  votes    Vote[]
  comments GameComment[]
  reviews  GameReview[]

  @@unique([groupId, gameId])
  @@index([groupId])
  // "Juegos recientes" del inicio: lo último que ha añadido cada uno
  @@index([addedById, addedAt])
}

model CollectionGame {
  id            String   @id @default(cuid())
  bggUsername   String
  bggId         Int
  name          String
  thumbnail     String?
  image         String?   @db.Text // portada grande (para la estantería)
  yearPublished Int?
  minPlayers    Int?
  maxPlayers    Int?
  bggRating     Float?
  bggRank       Int?
  weight        Float?
  playingTime   Int?
  numPlays      Int       @default(0)
  userRating    Float?
  bestWith      String?
  subtype       String    @default("boardgame") // boardgame | boardgameexpansion
  // Qué relación tiene el usuario con el juego en BGG. De momento
  // sincronizamos "own" (lo tiene) y "wishlist" (lo quiere).
  status           String    @default("own") // own | wishlist
  wishlistPriority Int?      // 1 (lo quiero ya) .. 5 (algún día), solo en wishlist
  // Juego base del que es expansión, según los enlaces de BGG. Lo rellena
  // enrichCollectionGames() y sobrevive a las resincronizaciones.
  baseBggId     Int?
  dateAdded     DateTime?
  fetchedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([bggUsername, bggId])
  @@index([bggUsername])
  @@index([bggUsername, status])
  @@index([bggRank])
  @@index([bggRating])
  @@index([numPlays])
  @@index([dateAdded])
  @@index([subtype])
  @@index([baseBggId])
}

// Lo que el usuario anota sobre un juego de su colección, al margen de lo que
// venga de BGG. `keepScore` es la puntuación de permanencia (1 "quiero
// venderlo" … 5 "no se irá nunca") y es PRIVADA: solo la ve su dueño, nunca
// se expone a los grupos ni se registra en el feed de actividad.
// Las expansiones heredan el keepScore de su juego base mientras no tengan
// uno propio (ver resolveKeepScore en src/lib/collection.ts).
// Va por userId (no por bggUsername) para que sobreviva a un cambio de
// usuario de BGG.
model CollectionEntry {
  id        String   @id @default(cuid())
  userId    String
  bggId     Int
  keepScore Int?     // 1-5
  note      String?
  showcased Boolean  @default(false) // aparece en la vitrina del perfil
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bggId])
  @@index([userId])
  @@index([userId, keepScore])
  @@index([userId, showcased])
}

// Ficha de BGG de cualquier juego, lo tenga alguien o no: de qué va
// (mecánicas, categorías, autores, familias) y cuánto gusta. Es la materia
// prima de las recomendaciones. Se rellena por lotes desde BGG, empezando por
// los juegos de las colecciones de la comunidad y los más comentados en BGG.
model BggGameInfo {
  bggId         Int      @id
  name          String
  thumbnail     String?
  image         String?  @db.Text
  subtype       String   @default("boardgame") // boardgame | boardgameexpansion
  yearPublished Int?
  minPlayers    Int?
  maxPlayers    Int?
  playingTime   Int?
  bggRating     Float?
  bggRank       Int?
  usersRated    Int?
  weight        Float?
  mechanics     String[] @default([])
  categories    String[] @default([])
  designers     String[] @default([])
  families      String[] @default([])
  // Juegos que son "el mismo juego" en otra versión: lo reimplementa o lo
  // reimplementan (en los dos sentidos) o se integra con él. Si tienes uno,
  // no te recomendamos los otros.
  relatedIds    Int[]    @default([])
  fetchedAt     DateTime @default(now())

  @@index([fetchedAt])
}

// Todo lo que un usuario de BGG tiene apuntado de un juego base, más allá de
// lo que tiene o quiere: lo que tuvo, lo que ha jugado y lo que ha puntuado.
// Las recomendaciones lo usan para no proponerte nada que ya conozcas y para
// saber qué te gusta. Se sustituye entero en cada sincronización.
model BggUserGame {
  bggUsername String
  bggId       Int
  name        String
  own         Boolean  @default(false)
  prevOwned   Boolean  @default(false)
  wishlist    Boolean  @default(false)
  numPlays    Int      @default(0)
  userRating  Float?
  fetchedAt   DateTime @default(now())

  @@id([bggUsername, bggId])
  @@index([bggId])
  @@index([userRating])
}

// Lo que el usuario decide sobre un juego que no tiene: guardarlo en su
// wishlist de BG Planner o descartarlo ("no me interesa") para que no se lo
// volvamos a recomendar. Va por userId, como CollectionEntry.
model UserGameFlag {
  id        String   @id @default(cuid())
  userId    String
  bggId     Int
  kind      String   // wishlist | dismissed
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bggId])
  @@index([userId, kind])
}

model GameComment {
  id          String    @id @default(cuid())
  groupGameId String
  userId      String
  text        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  groupGame GroupGame @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([groupGameId, userId])
  @@index([groupGameId])
  @@index([userId])
}

// Crónica / reseña post-partida: opinión de un usuario sobre un juego del
// grupo DESPUÉS de jugarlo. A diferencia de GameComment (nota de por qué se
// propone, 1 por usuario/juego), aquí puede haber varias por usuario/juego
// (una por partida) y llevan nota y fotos. Alimenta el feed y la galería.
model GameReview {
  id          String   @id @default(cuid())
  groupGameId String
  userId      String
  sessionId   String?  // enlace opcional a una partida concreta
  rating      Int?     // 1-5, opcional
  text        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groupGame GroupGame         @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])
  session   GameSession?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  photos    GameReviewPhoto[]

  @@index([groupGameId])
  @@index([userId])
  @@index([sessionId])
}

model GameReviewPhoto {
  id        String   @id @default(cuid())
  reviewId  String
  url       String   @db.Text // URL pública en Supabase Storage
  order     Int      @default(0)
  createdAt DateTime @default(now())

  review GameReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// Foto suelta de la galería de un grupo, no atada a ninguna opinión. La sube
// cualquier miembro.
model GroupPhoto {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  url       String   @db.Text // URL pública en Supabase Storage
  caption   String?
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([groupId])
  @@index([userId])
}

model Vote {
  id          String   @id @default(cuid())
  groupGameId String
  userId      String
  value       Int      @default(1)
  createdAt   DateTime @default(now())

  groupGame GroupGame @relation(fields: [groupGameId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupGameId, userId])
  @@index([groupGameId])
  @@index([userId])
}

model Event {
  id           String    @id @default(cuid())
  name         String
  description  String?
  // Info general: el texto largo (horarios, normas, cómo llegar…) que se
  // enseña en la ficha pública y en la pestaña "Info" del evento.
  about        String?   @db.Text
  date         DateTime
  endDate      DateTime?
  location     String?
  maxAttendees Int?
  imageUrl     String?   @db.Text
  visibility   String    @default("public") // public | private
  inviteCode   String?   @unique
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Juegos tomados de una geeklist de BGG en vez de elegidos a mano. null =
  // a mano. La lista se reimporta sola (ver lib/geeklist.ts).
  bggGeeklistId     Int?
  geeklistTitle     String?
  geeklistSyncedAt  DateTime? // última importación buena
  geeklistCheckedAt DateTime? // último intento: evita importar dos veces a la vez
  geeklistError     String?   // por qué falló el último intento, si falló

  createdBy User            @relation("EventCreator", fields: [createdById], references: [id])
  games     EventGame[]
  reviews   EventReview[]
  photos    EventPhoto[]
  attendees    EventAttendee[]
  activityLogs ActivityLog[]
  notifications Notification[]

  @@index([date])
  @@index([visibility])
}

model EventGame {
  id        String   @id @default(cuid())
  eventId   String
  gameId    String
  addedById String
  addedAt   DateTime @default(now())
  // Ha llegado desde la geeklist vinculada al evento
  fromGeeklist   Boolean   @default(false)
  // Ha salido de la lista pero alguien había marcado interés: se queda,
  // señalado, en vez de borrarse con sus intereses
  leftGeeklistAt DateTime?

  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  game      Game                @relation(fields: [gameId], references: [id])
  addedBy   User                @relation("EventGameAdder", fields: [addedById], references: [id])
  interests EventGameInterest[]

  @@unique([eventId, gameId])
  @@index([eventId])
}

model EventAttendee {
  id       String   @id @default(cuid())
  eventId  String
  userId   String
  status   String   @default("attending") // attending | maybe | cancelled
  // attendee | admin. Los admins gestionan el evento como su creador (que no
  // tiene fila especial: se reconoce por Event.createdById), salvo borrarlo.
  role     String   @default("attendee")
  joinedAt DateTime @default(now())
  // Enlace de solo lectura a "Mi Lista" en este evento. null = no compartida.
  // Regenerarlo invalida el enlace anterior.
  listShareToken String? @unique

  event     Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                @relation(fields: [userId], references: [id])
  interests EventGameInterest[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventGameInterest {
  id          String   @id @default(cuid())
  eventGameId String
  attendeeId  String
  intensity   Int      // 1-5
  notes       String?
  playedAt    DateTime? // marcado como jugado desde "Mi Lista"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  eventGame EventGame     @relation(fields: [eventGameId], references: [id], onDelete: Cascade)
  attendee  EventAttendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@unique([eventGameId, attendeeId])
  @@index([eventGameId])
  @@index([attendeeId])
}

// Valoración de un evento por un asistente (nota + comentario). Una por
// usuario y evento. Se pide por email cuando el evento acaba.
model EventReview {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  rating    Int?     // 1-5, opcional
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

// Foto de la galería de un evento. Cualquier participante (creador o
// asistente) puede subir; no va atada a una valoración.
model EventPhoto {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  url       String   @db.Text // URL pública en Supabase Storage
  caption   String?
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  scope     String   @default("internal")
  userId    String
  groupId   String?
  eventId   String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id])
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([groupId, createdAt])
  @@index([eventId, createdAt])
}

// Caché durable de imágenes de juegos de BGG (por bggId), para no volver a
// pedir a BGG las fotos de resultados de búsqueda ya vistos. Solo positivos.
model BggThumbnail {
  bggId     Int      @id
  thumbnail String?
  fetchedAt DateTime @default(now())
}

// Lo que manda un usuario desde /roadmap: una idea o un error. Se publica al
// momento como propuesta votable (`featureId`), y aquí queda el texto original
// con su autor y sus capturas, que solo ve el admin. Varios feedbacks pueden
// apuntar a la misma propuesta si el admin los agrupa.
model Feedback {
  id           String    @id @default(cuid())
  userId       String
  subject      String
  message      String    @db.Text
  images       String[]  @default([]) // URLs públicas en Supabase Storage
  status       String    @default("published") // published | hidden
  adminNote    String?   @db.Text
  featureId    String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User     @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?    @relation("FeedbackReviewer", fields: [reviewedById], references: [id])
  feature    Feature? @relation(fields: [featureId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([featureId])
}

// Propuesta de funcionalidad del roadmap público (/roadmap), votable por
// cualquier usuario registrado. Nace de un feedback aceptado o la crea el
// superadmin a mano.
model Feature {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("proposed") // proposed | planned | in_progress | done | discarded
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?         @relation("FeatureCreator", fields: [createdById], references: [id])
  votes     FeatureVote[]
  feedbacks Feedback[]

  @@index([status, createdAt])
}

// Un voto por usuario y propuesta: "esta es la que más me interesa".
model FeatureVote {
  id        String   @id @default(cuid())
  featureId String
  userId    String
  createdAt DateTime @default(now())

  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([featureId, userId])
  @@index([featureId])
  @@index([userId])
}

// Amigos: cada uno lleva su propia lista y añadir a alguien es un clic, sin
// solicitudes ni aceptación. Que tú tengas a alguien no hace que él te tenga
// a ti; para eso tendrá que añadirte él.
model Friendship {
  id        String   @id @default(cuid())
  userId    String
  friendId  String
  createdAt DateTime @default(now())

  user   User @relation("FriendshipOwner", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendshipFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
}

// Avisos dentro de la web (la campana). Sustituyen a los emails que no
// merecían salir de la app. El texto no se guarda: se compone al servirlos,
// con los nombres de grupo y evento al día.
model Notification {
  id        String    @id @default(cuid())
  userId    String    // quien la recibe
  actorId   String?   // quien la provoca; null en los recordatorios
  type      String
  groupId   String?
  eventId   String?
  metadata  Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User   @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([createdAt])
}

// Un dispositivo (navegador o PWA instalada) que ha pedido recibir las
// notificaciones como push. `endpoint` lo da el servicio de push del
// navegador (FCM, Apple, Mozilla…) y es único por dispositivo; si en ese
// dispositivo entra otra cuenta, la suscripción pasa a ser suya.
model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Hilo del foro público (/community): título + primer mensaje, con una
// etiqueta de las fijas de src/lib/community.ts para poder filtrar. Se ordena
// por `lastActivityAt`, que sube con cada respuesta (como en un foro de toda
// la vida). Borrar es lógico (`deletedAt`) para no perder la conversación de
// golpe si alguien se arrepiente o lo retira un admin.
model CommunityThread {
  id             String    @id @default(cuid())
  authorId       String
  title          String
  body           String    @db.Text
  tag            String
  pinned         Boolean   @default(false) // fijado arriba por un admin
  lastActivityAt DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies CommunityReply[]

  @@index([deletedAt, lastActivityAt])
  @@index([tag, lastActivityAt])
  @@index([authorId])
}

// Respuesta a un hilo. Lista plana y cronológica; una borrada deja su hueco
// ("mensaje eliminado") para que el resto de la conversación siga teniendo
// sentido. Para contestar a un mensaje concreto se cita (`quotedReplyId`, de
// este mismo hilo) en vez de anidar: la conversación sigue leyéndose de
// arriba abajo.
model CommunityReply {
  id            String    @id @default(cuid())
  threadId      String
  authorId      String
  body          String    @db.Text
  quotedReplyId String?
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())

  thread      CommunityThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  quotedReply CommunityReply?      @relation("ReplyQuote", fields: [quotedReplyId], references: [id], onDelete: SetNull)
  quotedBy    CommunityReply[]     @relation("ReplyQuote")
  likes       CommunityReplyLike[]

  @@index([threadId, createdAt])
  @@index([authorId])
}

// «Me gusta» a una respuesta de la Comunidad. Uno por persona y respuesta, y
// nunca a una propia.
model CommunityReplyLike {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime @default(now())

  reply CommunityReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId])
}

// Denuncia de un contenido (hilo, respuesta, foto, opinión) o de un usuario.
// Lo exigen App Store y Google Play para el contenido que suben los usuarios.
// `targetType` es uno de REPORT_TARGET_TYPES (src/lib/reports.ts) y
// `targetId`, el id de esa fila; `targetUserId` es su autor, para la cola de
// /admin. Una por persona y objetivo. Se cierra entera (todas las pendientes
// del mismo objetivo) al retirar el contenido o al descartarla.
model Report {
  id           String    @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  targetUserId String?
  reason       String    // spam | offensive | inappropriate | other
  text         String?   @db.Text
  status       String    @default("pending") // pending | resolved | dismissed
  createdAt    DateTime  @default(now())
  resolvedById String?
  resolvedAt   DateTime?

  reporter   User  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User? @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId])
}

// Bloqueo entre usuarios: quien bloquea deja de ver en la Comunidad lo que
// escribe el otro, de recibir sus avisos y de poder ser añadido por él a
// amigos. En grupos y eventos compartidos no se esconde nada.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Emails expulsados por incumplir los términos de uso (/terms). La cuenta se
// borra al expulsar (como al borrarla uno mismo) y el email se queda aquí para
// que no pueda volver a entrar ni cambiarse a él. `name` y `reason` son para
// la lista de /admin/reports; se quita la fila al readmitir.
model BannedEmail {
  email      String   @id // normalizado (trim + minúsculas)
  name       String?
  reason     String?  @db.Text
  bannedById String?
  createdAt  DateTime @default(now())
}
