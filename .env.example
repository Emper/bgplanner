# Supabase PostgreSQL (get from Supabase Dashboard > Settings > Database)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Resend (get from https://resend.com/api-keys)
RESEND_API_KEY="re_xxxxx"

# Auth - generate with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret-at-least-32-characters"

# BGG Authentication
# Personal API token (Bearer) from https://boardgamegeek.com/applications
BGG_API_TOKEN="your-bgg-bearer-token"

# App URL (change in production)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App nativa (Capacitor) — enlaces universales / App Links
# Team ID de Apple Developer (App Store Connect > Membership details).
# Lo usa /.well-known/apple-app-site-association. Sin él, esa ruta devuelve 503.
APPLE_TEAM_ID="ABCDE12345"
# Huella SHA-256 del certificado de firma de Android, en hex separado por ":".
# Varias separadas por comas (upload key + clave de Play App Signing).
# La usa /.well-known/assetlinks.json. Sin ella, esa ruta devuelve 503.
ANDROID_CERT_SHA256="AA:BB:CC:DD:...:FF"
